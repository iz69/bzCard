LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

MAX_UPLOAD_MB=50

# false: administrator-only single-user mode. User accounts and data are retained.
MULTI_USER_ENABLED=false

# Optional: a Fernet key used to encrypt per-user LINE connector credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, bzCard stores a generated key at data/line-credentials.key. Back it up with data/bzcard.db.
LINE_CREDENTIALS_ENCRYPTION_KEY=
SESSION_TTL_HOURS=720
