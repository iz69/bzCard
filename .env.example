UI_BASE_PATH=/bzcard/
API_BASE_PATH=/bzcard-api

# Dockerイメージで利用する永続データの保存先（docker-compose.yml）。
BZCARD_DATA_DIR=./data
BZCARD_OLLAMA_DIR=./ollama

LLM_PROVIDER=ollama
LLM_MODEL=bzcard-lfm-jp:202606

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

MAX_UPLOAD_MB=50

# yomitoku 0.14.0で使う文字認識モデル。従来と同じモデルを明示的に指定します。
OCR_RECOGNIZER_MODEL=parseq-large-v4_1

# false: 管理者のみが利用できるモード。登録済みのユーザーとデータは保持します。
MULTI_USER_ENABLED=false

# 任意設定: 利用者ごとのLINE連携の認証情報を暗号化するFernetキー。
# 生成コマンド: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 未指定の場合はデータ保存先に line-credentials.key を自動作成します。DBと一緒にバックアップしてください。
LINE_CREDENTIALS_ENCRYPTION_KEY=
SESSION_TTL_HOURS=720
